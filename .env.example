# Segredo para assinar o cookie de sessão (obrigatório em produção).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Postgres de produção (Neon, Supabase, RDS…). Sem ela, usa PGlite local.
# DATABASE_URL=postgres://usuario:senha@host:5432/equilibra

# Pasta do banco PGlite local (opcional; padrão: ./.data/pglite)
# PGLITE_DIR=./.data/pglite

# URL pública da aplicação (usada pelo client RPC fora do navegador)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# E-mail transacional (Resend). Sem a chave, os e-mails ficam salvos em .data/emails/ (dev).
# RESEND_API_KEY=re_xxx
# EMAIL_FROM="Equilibra <nao-responda@seudominio.com.br>"

# URL pública usada nos links dos e-mails (ex.: https://equilibra.vercel.app)
# APP_URL=https://equilibra.vercel.app

# Segredo do Vercel Cron (lembretes diários de campanha)
# CRON_SECRET=

# Jev (modelo de decisão da TypeSafe) via Vercel AI Gateway.
# Local: crie uma chave em Vercel → AI Gateway → API Keys. Na Vercel, o token OIDC
# do deploy já autentica sozinho. Sem credencial, as decisões usam regras locais.
# AI_GATEWAY_API_KEY=
# JEV_MODEL=typesafe-ai/jev
